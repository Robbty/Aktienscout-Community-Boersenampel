{
  "manifest_version": 3,
  "name": "Börsenampel Watcher",
  "version": "0.7.0",
  "description": "Überwacht die Börsenampel der Aktienscout-Community auf Skool und wertet die Circle-Aktienengagements aus (investiert, realisiert, unrealisiert).",
  "browser_specific_settings": {
    "gecko": {
      "id": "boersenampel-watcher@aktienscout",
      "strict_min_version": "121.0"
    }
  },
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": [
    "https://www.skool.com/*",
    "https://query1.finance.yahoo.com/*",
    "https://query2.finance.yahoo.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "scripts": ["lib/debug.js", "lib/ampel.js", "lib/circle.js", "lib/quotes.js", "lib/events.js", "lib/sync-webdav.js", "lib/sync-flush.js", "background.js"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Börsenampel",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.skool.com/cybermoney-1123/classroom/8d4e7683*"],
      "js": ["lib/ampel.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
