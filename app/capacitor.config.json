{
  "appId": "de.aktienscout.boersenampel",
  "appName": "Börsenampel",
  "webDir": "www",
  "plugins": {
    "CapacitorHttp": { "enabled": true },
    "CapacitorCookies": { "enabled": true },
    "BackgroundRunner": {
